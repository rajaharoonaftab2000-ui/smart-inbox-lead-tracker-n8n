    {
      "parameters": {
        "inputText": "={{ $json.snippet }}",
        "categories": {
          "categories": [
            {
              "category": "Lead",
              "description": "Emails from potential customers showing interest in buying or using our products or services. This includes requests for pricing, quotations, demos, consultations, or a new automation project, and questions about whether our services can help their business.  Examples: \"I need an automation for my company\", \"How much would this workflow cost?\", or \"Can you build this for my business?\"  Classify based on the sender's meaning and buying interest, even if the word \"lead\" is never mentioned. General educational questions without buying interest belong to Question. Problems or dissatisfaction with an existing service belong to Complaint."
            },
            {
              "category": "Complaint",
              "description": "Emails reporting a problem or expressing dissatisfaction with an existing product, service, or order. Includes services not working, delays, poor quality, billing errors, and refund requests related to a problem.  Examples: \"My automation has stopped working\" or \"I paid for the service but it has not been delivered.\""
            },
            {
              "category": "Question",
              "description": "Emails asking for general information, explanations, or guidance without clear interest in purchasing a service and without reporting a problem.  Examples: \"What is automation?\" or \"How does Gmail integration work?\" Requests for pricing, quotations, or a new business project belong to Lead."
            },
            {
              "category": "Spam",
              "description": "Unsolicited and irrelevant promotional emails, scams, phishing attempts, suspicious links, or fake prize messages. Do not classify genuine customer inquiries or complaints as spam.  Examples: \"You won a lottery. Click here to claim your prize\" or an unrelated advertisement."
            }
          ]
        },
        "options": {}
      },
